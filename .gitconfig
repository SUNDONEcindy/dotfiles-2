# This is Git's per-user configuration file.
[user]
	name = David Karlsson
	email = 35727626+dvdksn@users.noreply.github.com
[push]
	autoSetupRemote = true
	default = current
[rerere]
	enabled = true
[rebase]
	autoSquash = true
	autoStash = true
[alias]
	last = log -1 HEAD
	# print default branch
	default = !git symbolic-ref refs/remotes/origin/HEAD | sed 's,^refs/remotes/origin/,,'
	# log commits on current branch
	l = !git default | xargs git cherry -v
	# interactive fixup
	fixup = "!git log -n 50 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git commit --fixup"
	# count commits on current branch
	cc = !git rev-list --count HEAD "^$(git default)"
	# resume rebase
	rbc = rebase --continue
	# rebase interactive
	rbi = rebase --interactive
	# rebase interactive commits on current branch
	rbb = !git rebase -i "HEAD~$(git cc)"
	# rebase on default branch
	rbm = !git rebase "$(git default)"
	# force push
	pf = push --force
	# cherry-pick
	cp = cherry-pick -s -x
	# commit all, amend, no-edit, sign-off
	can = commit --all --amend --no-edit --signoff
	# commit all, sign-off
	ca = commit --all --signoff
	# commit, sign-off
	c = commit --signoff
	# pull upstream, current branch
	lu = !git pull upstream "$(git rev-parse --abbrev-ref HEAD)"
	# checkout
	co = checkout
	# checkout new branch
	cb = checkout -b
	# rename branch
	bm = branch -m
	# delete branch
	bd = branch -D
	# delete all branches that were deleted on remote
	prune-branches = "!git fetch origin --prune && git branch -vv | grep ': gone]' | awk '{sub(/^[*+] /,\"\"); print $1}' | xargs -r git branch -D"
	# checkout default branch
	cm = !git checkout "$(git default)"
	# status
	st = status --short
	# fetch
	f = fetch
	# word diff
	wd = diff --word-diff
	# show last edits to file
	sl = log -1 -p --pretty="" --
[pull]
	ff = only
[init]
	defaultBranch = main
[credential]
	helper = store
[url "git@github.com:"]
	insteadOf = https://github.com/
[include]
	path = ~/.gitconfig.local
